# Database (Uses Docker service name "db" instead of "localhost")
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/pylambda

# Security
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=["*"]

# Phone Verification (Leave dummy values unless testing phone verification)
NUMVERIFY_BASE_URL=https://apilayer.net/api/validate
ACCESS_KEY=your-numverify-access-key

# Email / SMTP (Leave dummy values unless testing email sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true

# Password Reset
PASSWORD_RESET_API_URL=http://localhost:8000/apps/v1/auth/reset-password
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Redis (Uses Docker service name "redis")
REDIS_URL=redis://redis:6379/0
