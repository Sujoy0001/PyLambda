DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/pylambda
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGINS=["*"]
NUMVERIFY_BASE_URL=Base-url
ACCESS_KEY=Add-your-access-key-for-phone-number-verifictions
# SMTP settings for password reset emails. Replace these examples with your provider values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true
PASSWORD_RESET_API_URL=http://localhost:8000/v1/auth/reset-password
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
